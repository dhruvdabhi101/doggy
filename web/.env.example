# Copy this file to web/.env.local. Vite embeds VITE_ values in the public build.
# Use the public Project API key from PostHog project settings, never a personal or secret API key.
# An empty key turns off browser analytics and keeps the Ask page hidden.
VITE_POSTHOG_KEY=
# US Cloud. Use https://eu.i.posthog.com for EU Cloud, or your own PostHog host.
# The server must allow that host in its content security policy. See docs/ANALYTICS.md.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# The same project key and host as server POSTHOG_KEY / POSTHOG_HOST if you enable both.
# Ask stays hidden until the boolean flag "ask" is true. See docs/FEATURE_FLAGS.md.
