# Copy to server/.env (Bun loads it automatically; it's gitignored).
ANTHROPIC_API_KEY=
# Usage analytics. Same public Project API key and ingestion host as web/.env.local.
# Empty key disables server analytics. Never use a personal or secret API key here.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional overrides:
# DOGGY_MODEL_FAST=claude-haiku-5-5   # screen captures
# DOGGY_MODEL=claude-sonnet-5-5       # voice/text notes + ask (set to claude-haiku-5-5 to run everything on Haiku)
# PORT=8787
