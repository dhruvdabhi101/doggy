# Copy to server/.env. Bun loads that file when you start the server from server/.
# This example is safe to commit. Do not put a real key in it.
# An empty value is not the same as an unset value for variables that use a code default.
# Leave those commented unless you are setting a real override.

# Anthropic. If both are empty, extraction uses local pattern matching and Ask does not call a model.
# The SDK accepts either variable. hasLLM in server/src/llm.ts is true when either is non-empty.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Model ids sent to the Anthropic Messages API. These lines are the current code defaults.
# Screen captures use DOGGY_MODEL_FAST. Notes, voice, and Ask use DOGGY_MODEL.
DOGGY_MODEL_FAST=claude-haiku-5-5
DOGGY_MODEL=claude-sonnet-5-5

# Listen address. Code defaults if unset: PORT 8787, HOST 0.0.0.0 (all interfaces).
PORT=8787
HOST=0.0.0.0

# SQLite path. Unset default: server/data/doggy.db
# DOGGY_DB=

# Installer files served at /downloads (Doggy-mac.dmg, Doggy-windows.exe).
# Unset default: server/data/downloads
# DOGGY_DOWNLOADS=

# Public origin for OAuth metadata when the request host is not the public URL.
# No path. Example: https://doggy.example.com
# DOGGY_PUBLIC_URL=

# Extra hostname treated as this Doggy site. Captures of that host are skipped. No scheme.
# localhost, 127.0.0.1, and doggy.ruv.world are always treated as this site.
# DOGGY_PUBLIC_HOST=

# Delete capture rows whose captured_at is older than this many days. Default 30.
# The delete runs about once an hour and includes rows that are still pending.
# Seen-line fingerprints use a fixed 30 day window (SEEN_LINE_TTL_DAYS) and do not read this variable.
DOGGY_CAPTURE_RETENTION_DAYS=30

# Fast lane: milliseconds of quiet before a chat episode is extracted. Default 45000.
DOGGY_EPISODE_IDLE_MS=45000

# Slow lane: length of the clock-aligned window in milliseconds. Default 3600000 (one hour).
DOGGY_SLOW_LANE_MS=3600000

# Optional PostHog analytics. An empty POSTHOG_KEY disables server analytics.
# Use a project API key, not a personal key. NODE_ENV=test also disables server analytics.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# NODE_ENV=production
