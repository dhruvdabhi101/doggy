# Doggy does not load this file. It is an index of every environment variable the
# server and web app read. Copy the component files instead:
#
#   server:  cp server/.env.example server/.env
#   web:     cp web/.env.example web/.env.local
#
# The Mac and Windows agents do not read environment variables.
# They store the server URL and device token in a config file:
#   macOS:    ~/.doggy/agent.json
#   Windows:  %USERPROFILE%\.doggy\agent.json
# Fields: server, token, excludeApps. Windows also has deviceName.
# A file named "paused" in that same directory pauses capture.
# The desktop apps default the server URL to https://doggy.ruv.world until you change it.

# Server (server/src and the Anthropic SDK)
# ANTHROPIC_API_KEY          empty: no model calls
# ANTHROPIC_AUTH_TOKEN       alternative to ANTHROPIC_API_KEY, read by the SDK and hasLLM
# DOGGY_MODEL_FAST           default claude-haiku-5-5 (screen captures)
# DOGGY_MODEL                default claude-sonnet-5-5 (notes, voice, Ask)
# PORT                       default 8787
# HOST                       default 0.0.0.0
# DOGGY_DB                   default server/data/doggy.db
# DOGGY_DOWNLOADS            default server/data/downloads
# DOGGY_PUBLIC_URL           OAuth public origin; unset: derived from the request
# DOGGY_PUBLIC_HOST          extra host whose captures are skipped
# DOGGY_CAPTURE_RETENTION_DAYS  default 30 (by captured_at, pending rows included)
# DOGGY_EPISODE_IDLE_MS      default 45000
# DOGGY_SLOW_LANE_MS         default 3600000
# POSTHOG_KEY                empty: server analytics off
# POSTHOG_HOST               default https://us.i.posthog.com
# NODE_ENV                   test: server analytics off

# Web (Vite, baked in at build time)
# VITE_POSTHOG_KEY           empty: browser analytics off, Ask page hidden
# VITE_POSTHOG_HOST          default https://us.i.posthog.com

# Seen-line fingerprints expire after 30 days. That window is SEEN_LINE_TTL_DAYS
# in server/src/capture.ts. It is not an environment variable.
